<Window x:Class="WpfPostItDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfPostItDetector"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow"
        Width="1282"
        Height="846"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="#FF001822" ResizeMode="NoResize" Closing ="Window_Closing">

    <Canvas Background="#FF001822" Height="824" VerticalAlignment="Top" >
        <Label Content="סימולטור MRI" HorizontalAlignment="Left" VerticalAlignment="Top" Width="173" FontSize="22" FontWeight="Bold" FlowDirection="RightToLeft" Foreground="#FF009DFF" Canvas.Left="-13"/>
        <Image Height="119" Canvas.Left="20" Width="138" Source="/Images/5431964.png" Stretch="UniformToFill" Canvas.Top="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="278" Canvas.Left="988" Canvas.Top="13" Width="285" Fill="#FF002B3C" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="13" Width="285" Fill="#FF004A66" RenderTransformOrigin="0.536,0.502" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="הגדרות מצלמה" Canvas.Left="1070" Canvas.Top="15" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboBox"
                  Width="234"
                  Height="32"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding VideoDevices}"
                  SelectedItem="{Binding CurrentDevice}" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="14" Canvas.Left="1014" Canvas.Top="104" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <ComboBox Width="234" Height="34" x:Name="resolution" VerticalContentAlignment="Center" ItemsSource="{Binding Resolutions_st}" SelectedIndex="{Binding SelectedRes}" FontWeight="Bold" FontSize="14" Canvas.Left="1014" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Width="70"
            Height="34"
            Content="רזולוציה" Foreground="#FF36A0C8" FontSize="16" FlowDirection="RightToLeft" Canvas.Left="1096" Canvas.Top="146" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" />
        <Label Width="103"
               Height="32"
               Content="בחר מצלמה" Foreground="#FF36A0C8" FontSize="16" FlowDirection="RightToLeft" Canvas.Left="1079" Canvas.Top="69" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" />
        <Button Width="106"
                Height="32"
                Click="btnStart_Click"
                Content="הפעל מצלמה" RenderTransformOrigin="0.497,0.552" Foreground="#FF36A0C8" Background="{x:Null}" FontSize="14" Canvas.Left="1142" Canvas.Top="239" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF36A0C8" FontWeight="Bold" />
        <Button Width="106"
                Height="32"
                Click="btnStop_Click"
                Content="כבה מצלמה" Background="{x:Null}" FontSize="14" Canvas.Left="1014" Canvas.Top="239" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF36A0C8" Foreground="#FF36A0C8" FontWeight="Bold" />
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="303" Width="285" Fill="#FF004A66" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <GroupBox Header="הפעלת תוכנית" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="166" Canvas.Left="13" Canvas.Top="618" Width="632" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="הפעל" x:Name="Start_Program" Canvas.Left="521" Canvas.Top="662" Height="32" Width="98"  Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" Click="StartProgram_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="הפסק" x:Name="Stop_Program" Canvas.Left="408" Canvas.Top="662" Height="32" Width="93"  Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" Click="Stop_Program_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox Content="הפעל מיקרופון" IsChecked="{Binding IsMicrophoneEnabled, Mode=TwoWay}" Canvas.Left="468" Canvas.Top="726" Foreground="#FF009DFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Label Content="כמות תנועות :" x:Name="labelShiftDuration_Copy" Height="36" Width="210" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="167" Canvas.Top="660" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label  Content="{Binding MotionNumber}" Height="38" Width="148" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="107" Canvas.Top="660" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ProgressBar Height="28" Canvas.Left="30" Canvas.Top="714" Width="358" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <GroupBox Header="נגן סאונד MRI" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="166" Canvas.Left="345" Canvas.Top="458" Width="328" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Slider x:Name="audioSlider"
        Minimum="0"
        Maximum="{Binding NaturalDuration.TimeSpan.TotalSeconds, ElementName=mediaPlayer}"
        Value="{Binding Position.TotalSeconds, ElementName=mediaPlayer, Mode=OneWay}"
        Width="200"
        Height="20"
        Canvas.Left="446"
        Canvas.Top="556"
        ValueChanged="audioSlider_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Width="100"
        Height="30"
        Content="נגן"
        Click="btnPlaySound_Click" Canvas.Left="553" Canvas.Top="501" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Width="100"
        Height="30"
        Content="עצור"
        Click="btnStopSound_Click" Canvas.Left="432" Canvas.Top="501" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="{Binding RemainingTimeFormatted}" Width="100" Height="30" Canvas.Left="536" Canvas.Top="581" Foreground="#FF009DFF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="עוצמה" RenderTransformOrigin="0.486,0.592" Width="62" Canvas.Left="358" Canvas.Top="588" Foreground="#FF009DFF" FontSize="14" FlowDirection="RightToLeft" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="{Binding VolumePercentageWithSymbol}" Height="31" Width="46" Canvas.Left="397" Canvas.Top="471" Foreground="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Slider x:Name="volumeSlider"
        Width="96"
        Height="20"
        Minimum="0"
        Maximum="1"
        Value="{Binding Volume, Mode=TwoWay}"
        Canvas.Left="346" Canvas.Top="533" RenderTransformOrigin="0.5,0.5"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        >
            <Slider.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="270"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Slider.RenderTransform>
        </Slider>
        <Label Content="זמן תנועה" x:Name="labelShiftDuration" Height="36" Width="210" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="-22" Canvas.Top="416" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image Height="76" Width="73" Source="/Images/Button_Icon_Green.svg.png" x:Name="pictureBox_NotMoving" Canvas.Left="52" Canvas.Top="314" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image Height="76" Width="73" Source="/Images/Button_Icon_Red.svg.png" x:Name="pictureBox_Moving" Canvas.Left="52" Canvas.Top="314" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="1" Canvas.Left="1014" Stroke="#FF004A66" Canvas.Top="228" Width="233" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="443" Canvas.Left="320" Canvas.Top="13" Width="639" Fill="#FF002B3C" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="320" Canvas.Top="13" Width="639" Fill="#FF004A66" RenderTransformOrigin="0.536,0.502" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image x:Name="videoPlayer" Height="367" Width="587" Canvas.Left="346" Canvas.Top="66" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Label Content="מצלמה" Canvas.Left="883" Canvas.Top="15" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Rectangle Height="208" Canvas.Left="988" Canvas.Top="341" Width="285" Fill="#FF002B3C" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Content="זיהוי תנועה" Canvas.Left="1086" Canvas.Top="305" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbMotionDetection"
                  Width="118"
                  Height="20"
                  Content="הפעל גילוי תנועה"
                  IsChecked="{Binding MotionDetectionEnabled}" Foreground="#FF36A0C8" FontWeight="Bold" RenderTransformOrigin="0.463,0.168" Canvas.Left="1045" Canvas.Top="363" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Slider x:Name="thresholdSlider"
        Width="206"
        Height="23"
        Minimum="1"
        Maximum="1000"
        Value="{Binding MotionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Canvas.Left="1026" Canvas.Top="456" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <TextBox x:Name="thresholdTextBox"
         Width="116"
         Height="32"
         Text="{Binding MotionThreshold, Mode=TwoWay, StringFormat=\{0:F0\}, UpdateSourceTrigger=PropertyChanged}" 
         PreviewTextInput="thresholdTextBox_PreviewTextInput" 
         LostFocus="thresholdTextBox_LostFocus" FontSize="18" Canvas.Left="1035" Canvas.Top="408" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Button Width="146"
            Height="33"
            Click="btnSave_Click"
            Content="שמירת סף רגישות" RenderTransformOrigin="0.5,0.5" Foreground="#FF36A0C8" Background="{x:Null}" BorderBrush="#FF36A0C8" FontSize="14" FontWeight="Bold" Canvas.Left="1056" Canvas.Top="494" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Label Content="סף רגישות :" Foreground="#FF36A0C8" FlowDirection="RightToLeft" FontSize="14" FontWeight="Bold" Canvas.Left="1155" Canvas.Top="411" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="560" Width="285" Fill="#FF004A66" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="208" Canvas.Left="988" Canvas.Top="598" Width="285" Fill="#FF002B3C" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Content="נגן סאונד MRI" Canvas.Left="1086" Canvas.Top="562" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Top" FlowDirection="RightToLeft"/>
    </Canvas>


</Window>
