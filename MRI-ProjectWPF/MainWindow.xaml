<Window x:Class="WpfPostItDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfPostItDetector"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow"
        Width="1291"
        Height="846"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="#FF31363B" ResizeMode="NoResize" Closing ="Window_Closing">

    <Canvas Background="#FF31363B" Height="826" VerticalAlignment="Top" >

        <GroupBox Header="זיהוי תנועה" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="414" Canvas.Left="993" Canvas.Top="147" HorizontalAlignment="Center" VerticalAlignment="Top" Width="264"/>

        <GroupBox Header="מצלמה" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="415" Canvas.Left="320" Canvas.Top="146" Width="642" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="#FF009DFF" Background="#FF3D3D3D"/>

        <GroupBox Header="נגן סאונד MRI" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="166" Canvas.Left="929" Canvas.Top="583" Width="328" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <Image x:Name="videoPlayer" Height="367" Canvas.Left="348" Canvas.Top="181" Width="587" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <CheckBox x:Name="cbMotionDetection"
                  Width="118"
                  Height="20"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Content="הפעל גילוי תנועה"
                  IsChecked="{Binding MotionDetectionEnabled}" Foreground="#FF009DFF" FontWeight="Bold" RenderTransformOrigin="0.463,0.168" Canvas.Left="1036" Canvas.Top="181">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Slider x:Name="thresholdSlider"
        Width="206"
        Height="23"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Minimum="1"
        Maximum="1000"
        Value="{Binding MotionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Canvas.Left="1022" Canvas.Top="276" />
        <TextBox x:Name="thresholdTextBox"
         Width="116"
         Height="32"
         HorizontalAlignment="Center"
         VerticalAlignment="Top"
         Text="{Binding MotionThreshold, Mode=TwoWay, StringFormat=\{0:F0\}, UpdateSourceTrigger=PropertyChanged}" 
         PreviewTextInput="thresholdTextBox_PreviewTextInput" 
         LostFocus="thresholdTextBox_LostFocus" FontSize="18" Canvas.Left="1031" Canvas.Top="228" />
        <Image HorizontalAlignment="Center" Height="76" VerticalAlignment="Top" Width="73" Source="/Images/Button_Icon_Green.svg.png" x:Name="pictureBox_NotMoving" Canvas.Left="1089" Canvas.Top="384"/>
        <Image HorizontalAlignment="Center" Height="76" VerticalAlignment="Top" Width="73" Source="/Images/Button_Icon_Red.svg.png" x:Name="pictureBox_Moving" Canvas.Left="1089" Canvas.Top="384"/>
        <Label Content="זמן תנועה" HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="labelShiftDuration" Height="37" Width="210" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="1022" Canvas.Top="493"/>
        <Button Width="146"
            Height="33"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="btnSave_Click"
            Content="שמירת סף רגישות" RenderTransformOrigin="0.5,0.5" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" Canvas.Left="1052" Canvas.Top="314" />
        <Label Content="סף רגישות :" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FF009DFF" FlowDirection="RightToLeft" FontSize="14" FontWeight="Bold" Canvas.Left="1151" Canvas.Top="231"/>
        <GroupBox Header="הגדרות מצלמה" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="83" Canvas.Left="38" Canvas.Top="24" Width="1054" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Width="102"
               Height="32"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Content="בחר מצלמה :" Foreground="#FF009DFF" FontSize="14" FlowDirection="RightToLeft" FontWeight="Bold" Canvas.Left="948" Canvas.Top="58" />
        <Button Width="124"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="btnStart_Click"
                Content="הפעל מצלמה" RenderTransformOrigin="0.497,0.552" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" Canvas.Left="554" Canvas.Top="58" />
        <Button Width="124"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="btnStop_Click"
                Content="כבה מצלמה" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" Canvas.Left="414" Canvas.Top="58" />
        <Label Width="76"
            Height="34"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="רזולוציה :" Foreground="#FF009DFF" FontSize="14" FlowDirection="RightToLeft" FontWeight="Bold" Canvas.Left="310" Canvas.Top="58" />
        <ComboBox HorizontalAlignment="Left" VerticalAlignment="Center" Width="234" Height="34" x:Name="resolution" VerticalContentAlignment="Center" ItemsSource="{Binding Resolutions_st}" SelectedIndex="{Binding SelectedRes}" FontWeight="Bold" FontSize="14" Canvas.Left="70" Canvas.Top="55"/>
        <ComboBox x:Name="comboBox"
                  Width="234"
                  Height="32"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding VideoDevices}"
                  SelectedItem="{Binding CurrentDevice}" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="14" Canvas.Left="708" Canvas.Top="58" />
        <Slider x:Name="audioSlider"
        Minimum="0"
        Maximum="{Binding NaturalDuration.TimeSpan.TotalSeconds, ElementName=mediaPlayer}"
        Value="{Binding Position.TotalSeconds, ElementName=mediaPlayer, Mode=OneWay}"
        Width="200"
        Height="20"
        Canvas.Left="1030"
        Canvas.Top="681"
        ValueChanged="audioSlider_ValueChanged" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Width="100"
        Height="30"
        Content="נגן"
        Click="btnPlaySound_Click" Canvas.Left="1137" Canvas.Top="626" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button Width="100"
        Height="30"
        Content="עצור"
        Click="btnStopSound_Click" Canvas.Left="1016" Canvas.Top="626" Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Content="{Binding RemainingTimeFormatted}" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" Height="30" Canvas.Left="1087" Canvas.Top="701" Foreground="#FF009DFF" FontSize="18"/>

        <Label Content="עוצמה" VerticalAlignment="Center" RenderTransformOrigin="0.486,0.592" HorizontalAlignment="Left" Width="62" Canvas.Left="942" Canvas.Top="713" Foreground="#FF009DFF" FontSize="14" FlowDirection="RightToLeft" FontWeight="Bold"/>
        <Label Content="סימולטור MRI" HorizontalAlignment="Left" VerticalAlignment="Top" Width="156" FontSize="22" FontWeight="Bold" FlowDirection="RightToLeft" Foreground="#FF009DFF" Canvas.Left="1118" Canvas.Top="15"/>
        <Image Height="119" Canvas.Left="1118" Canvas.Top="21" Width="138" Source="/Images/5431964.png" Stretch="UniformToFill"/>
        <GroupBox Header="הפעלת תוכנית" FlowDirection="RightToLeft" Foreground="#FF009DFF" FontSize="18" FontWeight="Bold" Height="166" Canvas.Left="86" Canvas.Top="583" Width="780" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="הפעל" Name="Start_Program" Canvas.Left="742" Canvas.Top="626" Height="33" Width="98"  Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Click="StartProgram_Click"/>
        <Button Content="הפסק" Name="Stop_Program" Canvas.Left="629" Canvas.Top="626" Height="33" Width="93"  Foreground="#FF009DFF" Background="#FF31363B" BorderBrush="#FF009DFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Stop_Program_Click"/>
        <Label Content="{Binding VolumePercentageWithSymbol}" HorizontalAlignment="Left" Height="31" Width="46" Canvas.Left="957" Canvas.Top="594" Foreground="#FF009DFF" FontSize="14" VerticalAlignment="Center" FontWeight="Bold"/>
        <Slider x:Name="volumeSlider"
        Width="96"
        Height="20"
        Minimum="0"
        Maximum="1"
        Value="{Binding Volume, Mode=TwoWay}"
        HorizontalAlignment="Center"
        VerticalAlignment="Top" Canvas.Left="930" Canvas.Top="658" RenderTransformOrigin="0.5,0.5"
        >
            <Slider.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="270"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Slider.RenderTransform>
        </Slider>
        <CheckBox Content="הפעל מיקרופון" IsChecked="{Binding IsMicrophoneEnabled, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="689" Canvas.Top="691" Foreground="#FF009DFF" FontWeight="Bold">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Label Content="כמות תנועות :" x:Name="labelShiftDuration_Copy" Height="37" Width="210" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="388" Canvas.Top="624" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label  Content="{Binding MotionNumber}" Height="38" Width="148" Foreground="#FF009DFF" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="328" Canvas.Top="624" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Canvas>


</Window>
