<Window x:Class="WpfPostItDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfPostItDetector"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow"
        Width="1299"
        Height="884"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="#FF001822" ResizeMode="NoResize" Closing ="Window_Closing">

    <Canvas Background="#FF001319" Height="869" VerticalAlignment="Top" >
        <Ellipse Height="462" Canvas.Left="25" Canvas.Top="34" Width="457" Fill="#FF001822" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.161"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Height="462" Canvas.Left="820" Canvas.Top="28" Width="457" Fill="#FF001822" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.161"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Height="438" Canvas.Left="896" Canvas.Top="467" Width="443" Fill="#FF00AEB6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Ellipse Height="274" Canvas.Left="-66" Canvas.Top="-77" Width="281" Fill="#FF00AEB6"/>
        <Rectangle Height="278" Canvas.Left="988" Canvas.Top="13" Width="285" Fill="#FF002938" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="13" Width="285" Fill="#FF004A66" RenderTransformOrigin="0.536,0.502" HorizontalAlignment="Left" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <Label Content="הגדרות מצלמה" Canvas.Left="1134" Canvas.Top="13" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboBox"
                  Width="234"
                  Height="32"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding VideoDevices}"
                  SelectedItem="{Binding CurrentDevice}" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="14" Canvas.Left="1014" Canvas.Top="104" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <ComboBox Width="234" Height="34" x:Name="resolution" VerticalContentAlignment="Center" ItemsSource="{Binding Resolutions_st}" SelectedIndex="{Binding SelectedRes}" FontWeight="Bold" FontSize="14" Canvas.Left="1014" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Width="70"
            Height="34"
            Content="רזולוציה" Foreground="#FF36A0C8" FontSize="16" FlowDirection="RightToLeft" Canvas.Left="1096" Canvas.Top="146" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" />
        <Label Width="103"
               Height="32"
               Content="בחר מצלמה" Foreground="#FF36A0C8" FontSize="16" FlowDirection="RightToLeft" Canvas.Left="1079" Canvas.Top="69" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" />
        <Button Width="106"
                Height="32"
                Click="btnStart_Click"
                Content="הפעל מצלמה" RenderTransformOrigin="0.497,0.552" Foreground="#FF36A0C8" Background="{x:Null}" FontSize="14" Canvas.Left="1142" Canvas.Top="239" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF36A0C8" FontWeight="Bold" />
        <Button Width="106"
                Height="32"
                Click="btnStop_Click"
                Content="כבה מצלמה" Background="{x:Null}" FontSize="14" Canvas.Left="1014" Canvas.Top="239" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF36A0C8" Foreground="#FF36A0C8" FontWeight="Bold" />
        <Rectangle Height="1" Canvas.Left="1014" Stroke="#FF004A66" Canvas.Top="228" Width="233" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="443" Canvas.Left="320" Canvas.Top="13" Width="639" Fill="#FF002938" HorizontalAlignment="Left" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <Rectangle Height="38" Canvas.Left="320" Canvas.Top="13" Width="639" Fill="#FF004A66" RenderTransformOrigin="0.536,0.502" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="7.373" RadiusY="7.373"/>
        <Image x:Name="videoPlayer" Height="367" Width="587" Canvas.Left="355" Canvas.Top="68" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Label Content="מצלמה" Canvas.Left="882" Canvas.Top="15" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="208" Canvas.Left="988" Canvas.Top="341" Width="285" Fill="#FF002938" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <CheckBox x:Name="cbMotionDetection"
                  Width="118"
                  Height="20"
                  Content="הפעל גילוי תנועה"
                  IsChecked="{Binding MotionDetectionEnabled}" Foreground="#FF36A0C8" FontWeight="Bold" RenderTransformOrigin="0.463,0.168" Canvas.Left="1045" Canvas.Top="363" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Slider x:Name="thresholdSlider"
        Width="206"
        Height="23"
        Minimum="1"
        Maximum="1000"
        Value="{Binding MotionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Canvas.Left="1026" Canvas.Top="456" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <TextBox x:Name="thresholdTextBox"
         Width="116"
         Height="32"
         Text="{Binding MotionThreshold, Mode=TwoWay, StringFormat=\{0:F0\}, UpdateSourceTrigger=PropertyChanged}" 
         PreviewTextInput="thresholdTextBox_PreviewTextInput" 
         LostFocus="thresholdTextBox_LostFocus" FontSize="18" Canvas.Left="1035" Canvas.Top="408" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Button Width="182"
            Height="43"
            Click="btnSave_Click"
            Content="שמירת סף רגישות" RenderTransformOrigin="0.5,0.5" Foreground="#FF002938" Background="#FF6EC7CC" FontSize="18" FontWeight="Bold" Canvas.Left="1040" Canvas.Top="492" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{x:Null}" />
        <Label Content="סף רגישות :" Foreground="#FF36A0C8" FlowDirection="RightToLeft" FontSize="14" FontWeight="Bold" Canvas.Left="1155" Canvas.Top="411" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="222" Canvas.Left="988" Canvas.Top="598" Width="285" Fill="#FF002938" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <Button Width="100"
        Height="30"
        Content="נגן"
        Click="btnPlaySound_Click" Canvas.Left="1134" Canvas.Top="723" Foreground="#FF36A0C8" Background="#FF31363B" BorderBrush="#FF36A0C8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Width="100"
        Height="30"
        Content="עצור"
        Click="btnStopSound_Click" Canvas.Left="1134" Canvas.Top="763" Foreground="#FF36A0C8" Background="#FF31363B" BorderBrush="#FF36A0C8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="עוצמה" RenderTransformOrigin="0.486,0.592" Width="62" Canvas.Left="999" Canvas.Top="774" Foreground="#FF36A0C8" FontSize="14" FlowDirection="RightToLeft" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="{Binding VolumePercentageWithSymbol}" Height="31" Width="46" Canvas.Left="1038" Canvas.Top="657" Foreground="#FF36A0C8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Slider x:Name="volumeSlider"
        Width="96"
        Height="20"
        Minimum="0"
        Maximum="1"
        Value="{Binding Volume, Mode=TwoWay}"
        Canvas.Left="987" Canvas.Top="719" RenderTransformOrigin="0.5,0.5"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        >
            <Slider.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="270"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Slider.RenderTransform>
        </Slider>
        <Slider x:Name="audioSlider"
        Minimum="0"
        Maximum="{Binding NaturalDuration.TimeSpan.TotalSeconds, ElementName=mediaPlayer}"
        Value="{Binding Position.TotalSeconds, ElementName=mediaPlayer, Mode=OneWay}"
        Width="200"
        Height="20"
        Canvas.Left="1030"
        Canvas.Top="624"
        ValueChanged="audioSlider_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="{Binding RemainingTimeFormatted}" Width="100" Height="30" Canvas.Left="1129" Canvas.Top="648" Foreground="#FF36A0C8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="314" Width="285" Fill="#FF004A66" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="7.373" RadiusY="7.373"/>
        <Label Content="זיהוי תנועה" Canvas.Left="1166" Canvas.Top="314" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="988" Canvas.Top="572" Width="285" Fill="#FF004A66" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="7.373" RadiusY="7.373"/>
        <Label Content="נגן סאונד MRI" Canvas.Left="1146" Canvas.Top="572" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
        <Rectangle Height="321" Canvas.Left="320" Canvas.Top="499" Width="639" Fill="#FF002938" RadiusX="7.373" RadiusY="7.373" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="38" Canvas.Left="320" Canvas.Top="473" Width="639" Fill="#FF004A66" RadiusX="7.373" RadiusY="7.373" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Content="הפעלת תוכנית" Canvas.Left="821" Canvas.Top="475" Foreground="#FFB9F8FF" FontSize="18" FlowDirection="RightToLeft" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Content="כמות תנועות :" x:Name="labelShiftDuration_Copy" Height="36" Width="210" Foreground="#FF36A0C8" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="728" Canvas.Top="672" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label  Content="{Binding MotionNumber}" Height="38" Width="148" Foreground="#FF36A0C8" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="661" Canvas.Top="672" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox Content=" הפעל מיקרופון" IsChecked="{Binding IsMicrophoneEnabled, Mode=TwoWay}" Canvas.Left="775" Canvas.Top="623" Foreground="#FF36A0C8" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Button Content="הפעל" x:Name="Start_Program" Canvas.Left="834" Canvas.Top="544" Height="38" Width="106"  Foreground="#FF002938" Background="#FF6EC7CC" FontSize="18" FontWeight="Bold" Click="StartProgram_Click" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{x:Null}" />
        <Button Content="הפסק" x:Name="Stop_Program" Canvas.Left="716" Canvas.Top="544" Height="38" Width="102" Background="#FF6EC7CC" FontSize="18" FontWeight="Bold" Click="Stop_Program_Click" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{x:Null}" Foreground="#FF002938"/>
        <Label Content="זמן תנועה :" x:Name="labelShiftDuration" Height="36" Width="210" Foreground="#FF36A0C8" FontSize="18" FlowDirection="RightToLeft" Canvas.Left="728" Canvas.Top="723" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="התראת תנועה" Canvas.Left="417" Canvas.Top="527" Foreground="#FFB9F8FF" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Image Height="76" Width="72" Source="/Images/Button_Icon_Red.svg.png" x:Name="pictureBox_Moving" Canvas.Left="441" Canvas.Top="587" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image Height="76" Width="73" Source="/Images/Button_Icon_Green.svg.png" x:Name="pictureBox_NotMoving" Canvas.Left="441" Canvas.Top="586" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image Height="272" Canvas.Left="10" Width="245" Source="/Images/5431964.png" Stretch="UniformToFill" Canvas.Top="609" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Content="סימולטור MRI" HorizontalAlignment="Center" VerticalAlignment="Top" Width="266" FontSize="30" FontWeight="Bold" FlowDirection="RightToLeft" Foreground="#FF2C9FC8" Canvas.Top="622"/>
        <Rectangle Height="1" Canvas.Left="716" Stroke="#FF004A66" Canvas.Top="663" Width="224" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="1" Canvas.Left="716" Stroke="#FF004A66" Canvas.Top="605" Width="224" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="1" Canvas.Left="714" Stroke="#FF004A66" Canvas.Top="715" Width="224" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="1" Canvas.Left="366" Stroke="#FF004A66" Canvas.Top="566" Width="224" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Canvas>


</Window>
