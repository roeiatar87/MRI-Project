<Window x:Class="WpfPostItDetector.WindowMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPostItDetector"
        mc:Ignorable="d"
        Title="WindowMain" Height="884" Width="1676">
    <Grid>
        <Rectangle Fill="#FF002938" RadiusX="7.373" RadiusY="7.373" Margin="1128,27,263,563"/>
        <Rectangle Fill="#FF004A66" RenderTransformOrigin="0.536,0.502" RadiusX="7.373" RadiusY="7.373" Margin="1128,27,263,803"/>
        <Label Content="הגדרות מצלמה" Foreground="#FFB9F8FF" FontSize="20" FontFamily="Arial" Margin="1274,27,273,808"/>
        <ComboBox x:Name="comboBox"
            DisplayMemberPath="Name"
            ItemsSource="{Binding VideoDevices}"
            SelectedItem="{Binding CurrentDevice}" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="14" Margin="1154,99,288,737" />
        <ComboBox x:Name="resolution" VerticalContentAlignment="Center" ItemsSource="{Binding Resolutions_st}" SelectedIndex="{Binding SelectedRes}" FontWeight="Bold" FontSize="14" Margin="1154,163,288,671"/>
        <Label
            Content="רזולוציה" Foreground="#FF36A0C8" FontSize="20" FlowDirection="RightToLeft" FontFamily="Arial" Margin="1224,129,362,705" />
        <Label
            Content="בחר מצלמה" Foreground="#FF36A0C8" FontSize="20" FlowDirection="RightToLeft" FontFamily="Arial" Margin="1212,65,346,771" />
        <Button
            Click="btnStart_Click"
            Content="הפעל מצלמה" RenderTransformOrigin="0.497,0.552" Foreground="#FF001822" Background="#FF6EC7CC" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" FontFamily="Arial" Margin="1281,263,289,573" >
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                        CornerRadius="18"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D5FFFA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button
            Click="btnStop_Click"
            Content="כבה מצלמה" Background="#FF6EC7CC" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" Foreground="#FF001822" FontFamily="Arial" Margin="1154,263,416,573" >
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                        CornerRadius="18"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D5FFFA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Rectangle Stroke="#FF004A66" RenderTransformOrigin="0.5,0.5" Margin="1154,252,289,615">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Button
            Click="btnSaveCamera_Click"
            Content=" הגדר כברירת מחדל" RenderTransformOrigin="0.497,0.552" Foreground="#FF001822" Background="#FF6EC7CC" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" FontFamily="Arial" Margin="1195,209,329,627" >
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                        CornerRadius="18"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D5FFFA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
